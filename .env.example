# NOVA-R Research Assistant Environment Configuration

# Flask Configuration
FLASK_SECRET_KEY=your-super-secret-key-change-this-in-production
SESSION_TYPE=filesystem

# Database Configuration
DATABASE_URL=sqlite:///data/novar.db

# Google OAuth Configuration (Optional - for user authentication)
# Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
AUTH_REQUIRED=false

# Frontend URL (for OAuth redirects)
# Development: http://localhost:5173
# Production: https://your-frontend-domain.com
FRONTEND_URL=http://localhost:5173

# NVIDIA API Configuration (Required for AI features)
# Get your API keys from: https://build.nvidia.com/
NVIDIA_TEXT_API_KEY=your-nemotron-ultra-api-key
NVIDIA_VISION_API_KEY=your-vision-model-api-key
NVIDIA_EMBED_API_KEY=your-embedqa-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# AI Model Configuration
LLM_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1
VISION_MODEL=meta/llama-3.2-90b-vision-instruct
EMBEDDING_MODEL=nvidia/nv-embedqa-mistral-7b-v2
RAG_TOP_K=4

# Web Search Configuration (Optional)
SEARCH_PROVIDER=duckduckgo
SERPAPI_KEY=your-serpapi-key-here

# File Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=52428800
MAX_DOCUMENTS_PER_SESSION=5